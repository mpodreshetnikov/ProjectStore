{
  "name": "engineering",
  "description": "Software engineering project: ADRs, epics, stories, kanban, retros, runbooks.",
  "folders": [
    {
      "path": "adr",
      "kind": "adr",
      "readme": true,
      "numbered": true,
      "prefix": "ADR-",
      "pad": 3,
      "purpose": "folder_purpose_adr",
      "not_this": "folder_not_this_adr"
    },
    {
      "path": "specs",
      "kind": "spec",
      "readme": true,
      "numbered": true,
      "prefix": "SPEC-",
      "pad": 3,
      "purpose": "folder_purpose_spec",
      "not_this": "folder_not_this_spec"
    },
    {
      "path": "epics",
      "kind": "epic",
      "readme": true,
      "subfolder_per_id": true,
      "story_prefix": "story-",
      "purpose": "folder_purpose_epic",
      "not_this": "folder_not_this_epic"
    },
    {
      "path": "research",
      "kind": "research",
      "readme": true,
      "purpose": "folder_purpose_research",
      "not_this": "folder_not_this_research"
    },
    {
      "path": "concepts",
      "kind": "concept",
      "readme": true,
      "purpose": "folder_purpose_concept",
      "not_this": "folder_not_this_concept"
    },
    {
      "path": "meetings",
      "kind": "meeting",
      "readme": true,
      "date_prefix": true,
      "purpose": "folder_purpose_meeting",
      "not_this": "folder_not_this_meeting"
    },
    {
      "path": "ops",
      "kind": "runbook",
      "readme": true,
      "purpose": "folder_purpose_runbook",
      "not_this": "folder_not_this_runbook"
    },
    {
      "path": "diagrams",
      "kind": "diagram",
      "readme": true,
      "purpose": "folder_purpose_diagram",
      "not_this": "folder_not_this_diagram"
    }
  ],
  "commands": [
    "adr",
    "spec",
    "epic",
    "story",
    "research",
    "concept",
    "meeting",
    "runbook",
    "diagram",
    "kanban"
  ],
  "agents": [
    "critic",
    "planner",
    "reviewer",
    "librarian",
    "archaeologist"
  ],
  "kanban": {
    "file": "kanban.md",
    "columns": [
      "Backlog",
      "ToDo",
      "In Progress",
      "Review",
      "Done"
    ],
    "source": "epics/*/stories/*.md"
  }
}
